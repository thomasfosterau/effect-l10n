{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": [
    "packages/*/src/**/*.test.ts",
    "vite.config.ts",
    "vite.package.ts",
    "packages/*/vite.config.ts"
  ],
  "ignoreDependencies": ["@arethetypeswrong/cli", "@typescript/native", "effect"],
  "rules": {
    "unused-files": "error",
    "unused-exports": "error",
    "unused-types": "error",
    "unused-dependencies": "error",
    "unused-dev-dependencies": "warn",
    "unused-enum-members": "error",
    "unused-class-members": "warn",
    "unresolved-imports": "error",
    "unlisted-dependencies": "error",
    "duplicate-exports": "error",
    "circular-dependencies": "error",
    "boundary-violation": "error",
    "stale-suppressions": "warn"
  },
  "boundaries": {
    "zones": [
      {
        "name": "messageformat",
        "patterns": ["packages/core/src/messageformat/**"]
      },
      {
        "name": "core",
        "patterns": ["packages/core/src/*.ts"]
      },
      {
        "name": "compiler",
        "patterns": ["packages/core/src/compiler/**"]
      },
      {
        "name": "testing",
        "patterns": ["packages/testing/**"]
      }
    ],
    "rules": [
      {
        "from": "testing",
        "allow": []
      },
      {
        "from": "messageformat",
        "allow": ["testing"]
      },
      {
        "from": "core",
        "allow": ["messageformat", "testing"]
      },
      {
        "from": "compiler",
        "allow": ["messageformat", "core", "testing"]
      }
    ],
    "coverage": {
      "requireAllFiles": true,
      "allowUnmatched": ["vite.config.ts", "vite.package.ts", "packages/*/vite.config.ts"]
    }
  },
  "health": {
    "maxCyclomatic": 20,
    "maxCognitive": 15,
    "maxCrap": 30,
    "coverage": "coverage/coverage-final.json"
  }
}
